# ── 飞书应用 ──
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
# Webhook-only：必填（事件订阅 → Verification Token）
FEISHU_VERIFICATION_TOKEN=xxxx
# 事件订阅里开启「加密」时填 Encrypt Key，否则留空
FEISHU_ENCRYPT_KEY=

# ── Linear ──
# api_key = 个人/服务 API Key（最快上手）
# oauth   = OAuth actor=app（支持 createAsUser / Agent 身份）
LINEAR_AUTH_MODE=api_key
LINEAR_API_KEY=lin_api_xxxx

# oauth 模式填写：
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/oauth/linear/callback
LINEAR_SCOPES=read,write,issues:create,comments:create,app:assignable,app:mentionable

# Webhook 签名密钥（Linear Settings → API → Webhooks）；生产环境必填
LINEAR_WEBHOOK_SECRET=xxxx
# App User ID（OAuth 安装后 /oauth/linear/callback 会返回；用于防回声）
LINEAR_APP_USER_ID=
LINEAR_ORG_ID=

# ── 链接展开 ──
# 飞书后台已配置「链接预览」→ true；未配置 → false（机器人回复卡片展开）
FEISHU_LINK_PREVIEW=true

# ── MCP 端点（/mcp）：留空则禁用 ──
MCP_TOKEN=

# ── AI（@机器人自然语言）──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── 数据库（Postgres）──
# 本地：postgres://postgres:pw@localhost:5432/fl
# Neon：使用 pooled 连接串（host 含 -pooler）
DATABASE_URL=postgres://postgres:pw@localhost:5432/fl
# docker compose 使用内置 Postgres 时设置
POSTGRES_PASSWORD=
# docker compose + Caddy 的域名
DOMAIN=

# ── 管理 / 定时任务鉴权 ──
# /api/* 的 Bearer Token；留空则管理 API 禁用
ADMIN_TOKEN=
# Vercel Cron 调用 /cron/cleanup 的 Bearer Token
CRON_SECRET=

# ── 服务 ──
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3000
