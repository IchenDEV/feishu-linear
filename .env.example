# ── 飞书应用 ──
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
# Webhook-only：必填（事件订阅 → Verification Token）
FEISHU_VERIFICATION_TOKEN=xxxx
# 事件订阅里开启「加密」时填 Encrypt Key，否则留空
FEISHU_ENCRYPT_KEY=

# ── Linear ──
# api_key = 个人/服务 API Key（最快上手）
# oauth   = OAuth actor=app（支持 createAsUser / Agent 身份）
LINEAR_AUTH_MODE=api_key
LINEAR_API_KEY=lin_api_xxxx

# oauth 模式填写：
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/oauth/linear/callback
LINEAR_SCOPES=read,write,issues:create,comments:create,app:assignable,app:mentionable

# Webhook 签名密钥（Linear Settings → API → Webhooks）
LINEAR_WEBHOOK_SECRET=xxxx
# App User ID（OAuth 安装后 /oauth/linear/callback 会返回；用于防回声）
LINEAR_APP_USER_ID=
LINEAR_ORG_ID=

# ── AI（@机器人自然语言）──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── 服务 ──
PORT=3000
HOST=0.0.0.0
DATABASE_URL=./data/feishu-linear.db
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3000
