# ── 飞书应用配置 ──
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_VERIFICATION_TOKEN=xxxx
FEISHU_ENCRYPT_KEY=xxxx

# ── Linear 配置 ──
LINEAR_API_KEY=lin_api_xxxx
LINEAR_WEBHOOK_SECRET=xxxx
# 可选：限定 Linear 组织 ID，用于安全校验
LINEAR_ORG_ID=

# ── AI 配置（用于 @Linear Agent 自然语言功能）──
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── 服务配置 ──
PORT=3000
HOST=0.0.0.0
DATABASE_URL=./data/feishu-linear.db
LOG_LEVEL=info

# ── 公网地址（用于 Webhook 回调）──
PUBLIC_URL=https://your-domain.com
