# Copy to .env (Node / Docker). See docs/installation.md for the full guide.

# ── Feishu / Lark app ──
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
# Required: Event Subscriptions → Verification Token
FEISHU_VERIFICATION_TOKEN=xxxx
# Only if "Encrypt Key" is enabled in Event Subscriptions; otherwise leave empty
FEISHU_ENCRYPT_KEY=

# ── Linear ──
# api_key = personal / service API key (fastest to start)
# oauth   = OAuth actor=app (comments appear as the real user; agent identity)
LINEAR_AUTH_MODE=api_key
LINEAR_API_KEY=lin_api_xxxx

# oauth mode only:
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/oauth/linear/callback
LINEAR_SCOPES=read,write,issues:create,comments:create,app:assignable,app:mentionable

# Webhook signing secret (Linear → Settings → API → Webhooks). Required in production.
LINEAR_WEBHOOK_SECRET=xxxx
# App user id (returned by /oauth/linear/callback; used for echo suppression)
LINEAR_APP_USER_ID=
LINEAR_ORG_ID=

# ── Language ──
# Workspace default language: zh-CN | en. Users, chats and admins can override it
# at runtime with `/linear lang`.
DEFAULT_LOCALE=zh-CN

# ── Link unfurling ──
# true  = Link Preview is configured in the Feishu console (url.preview.get)
# false = the bot replies with an unfurl card instead
FEISHU_LINK_PREVIEW=false

# ── MCP endpoint (/mcp): leave empty to disable ──
MCP_TOKEN=

# ── AI agent (@bot natural language): leave OPENAI_API_KEY empty to disable ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Database (Postgres) ──
# Local:  postgres://postgres:pw@localhost:5432/fl
# Neon:   use the pooled connection string (host contains -pooler)
DATABASE_URL=postgres://postgres:pw@localhost:5432/fl
# docker compose bundled Postgres
POSTGRES_PASSWORD=
# docker compose + Caddy domain
DOMAIN=

# ── Admin / cron auth ──
# Bearer token for /api/*; leave empty to disable the admin API
ADMIN_TOKEN=
# Bearer token for /cron/* (Vercel Cron sends it automatically)
CRON_SECRET=

# ── Server ──
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Public HTTPS URL of this service (used by Feishu / Linear callbacks)
PUBLIC_URL=http://localhost:3000
