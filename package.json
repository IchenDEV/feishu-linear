{
  "name": "feishu-linear",
  "version": "0.4.0",
  "description": "Feishu/Lark × Linear connector — the Linear for Slack experience, built for Feishu. 飞书 × Linear 连接器。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IchenDEV/feishu-linear.git"
  },
  "homepage": "https://github.com/IchenDEV/feishu-linear#readme",
  "bugs": "https://github.com/IchenDEV/feishu-linear/issues",
  "keywords": ["feishu", "lark", "linear", "integration", "cloudflare-workers", "agent", "mcp"],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/db/migrate.ts --format esm",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "setup:check": "tsx src/cli/doctor.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:prod": "node dist/db/migrate.js",
    "dev:worker": "wrangler dev --local",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@koa/router": "^13.1.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@linear/sdk": "^92.0.0",
    "@vercel/functions": "^3.9.11",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "koa": "^2.15.0",
    "nanoid": "^5.0.0",
    "openai": "^4.70.0",
    "pg": "^8.23.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.28.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@12.0.0",
  "license": "AGPL-3.0-only"
}
