{$DOMAIN} {
	encode zstd gzip

	# Only expose the paths Feishu / Linear / admin clients need; /api/* is guarded by ADMIN_TOKEN in the app
	@public path /health /webhook/feishu /webhook/linear /oauth/linear/* /api/* /mcp /h5/*
	handle @public {
		reverse_proxy app:3000
	}

	handle {
		respond "Not Found" 404
	}
}
