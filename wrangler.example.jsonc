// Example Workers config. Copy to wrangler.jsonc and adapt (wrangler.jsonc is gitignored —
// never commit your own domain / account details).
//   cp wrangler.example.jsonc wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feishu-linear",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The Feishu SDK reads its own package.json via __dirname at load time; Workers has none.
  "define": { "__dirname": "\"/\"" },

  // Custom domain (the zone must live in the same Cloudflare account). *.workers.dev is often
  // unreachable from mainland China, so use your own domain for Feishu callbacks.
  // "routes": [{ "pattern": "feishu-linear.example.com", "custom_domain": true }],

  // Run the Worker close to the database (use the cloud region of your Postgres, e.g. Neon's AWS region).
  // "placement": { "region": "aws:us-east-1" },

  // Database: by default the Worker connects directly; put the connection string in a secret:
  //   wrangler secret put DATABASE_URL
  // To cut per-request connection latency, enable Hyperdrive (the code prefers the HYPERDRIVE binding):
  //   wrangler hyperdrive create feishu-linear --connection-string="<direct url>"
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id>" }],

  // Daily cleanup (03:00 UTC) + view-subscription polling every 10 minutes → scheduled()
  "triggers": { "crons": ["0 3 * * *", "*/10 * * * *"] },

  // Non-secret config. Secrets: `wrangler secret put <NAME>` (or `wrangler deploy --secrets-file`).
  "vars": {
    "PUBLIC_URL": "https://feishu-linear.example.com",
    "LINEAR_AUTH_MODE": "api_key",
    "DEFAULT_LOCALE": "zh-CN",
    "FEISHU_LINK_PREVIEW": "false",
    "LOG_LEVEL": "info"
  }
}
