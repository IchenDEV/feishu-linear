// 示例配置：复制为 wrangler.jsonc 后按自己的环境修改（wrangler.jsonc 已被 .gitignore 忽略，
// 不要把自己的域名 / 账号信息提交到仓库）。
//   cp wrangler.example.jsonc wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feishu-linear",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 飞书 SDK 在加载时用 __dirname 读自身 package.json 取版本号；Workers 里没有，置空即可
  "define": { "__dirname": "\"/\"" },

  // 自定义域名（域名需托管在同一 Cloudflare 账号）。*.workers.dev 在中国大陆常无法解析，
  // 飞书回调建议使用自己的域名
  // "routes": [{ "pattern": "feishu-linear.example.com", "custom_domain": true }],

  // 让 Worker 跑在离数据库最近的机房（按数据库所在云区域填写，如 Neon 的 AWS 区域）
  // "placement": { "region": "aws:us-east-1" },

  // 数据库：默认 Worker 直连 Postgres，连接串放 secret：`wrangler secret put DATABASE_URL`。
  // 想降低每请求的建连延迟可启用 Hyperdrive（代码会优先使用 HYPERDRIVE 绑定）：
  //   wrangler hyperdrive create feishu-linear --connection-string="<直连地址>"
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id>" }],

  // 每天 03:00 UTC 清理去重记录 → scheduled()
  // 每日清理 + 每 10 分钟轮询视图订阅
  "triggers": { "crons": ["0 3 * * *", "*/10 * * * *"] },

  // 非敏感配置；密钥一律用 `wrangler secret put <NAME>`（或 `wrangler deploy --secrets-file`）
  "vars": {
    "PUBLIC_URL": "https://feishu-linear.example.com",
    "LINEAR_AUTH_MODE": "api_key",
    "LOG_LEVEL": "info"
  }
}
